# Пример .env для скрипта get_users.py.
# Скопируйте в .env и заполните реальными значениями для нужного реалма.
# ВАЖНО: реальный .env не должен попадать в git (см. .gitignore).

# URL сервера Keycloak
KC_SERVER_URL=https://predict-keycloak-k8s.adtech.vk.team

# Client ID клиента с включённым Service Accounts (client_credentials)
# в ЦЕЛЕВОМ реалме (не master)
KC_ADMIN_CLIENT_ID=admin-cli

# Client secret этого клиента (Clients -> <client> -> Credentials)
KC_ADMIN_CLIENT_SECRET=

# Имя целевого реалма, из которого нужно выгрузить пользователей
KC_REALM=

# Опционально: если заданы, HTTP OTP не будет спрашивать их интерактивно
# OTP_USERNAME=
# OTP_PIN=
